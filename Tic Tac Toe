def print_board(board):
    """Tic Tac Toe board """
    print("\n")
    for row in board:
        print(" | ".join(row))
        print("-" * 9)

def check_winner(board, player):
    """Checking if player won the game"""
    # Check rows, columns, and diagonals
    for i in range(3):
        if all(board[i][j] == player for j in range(3)) or all(board[j][i] == player for j in range(3)):
            return True
    return all(board[i][i] == player for i in range(3)) or all(board[i][2 - i] == player for i in range(3))

def is_draw(board):
    """Checks if the game is a draw"""
    return all(board[i][j] != " " for i in range(3) for j in range(3))

def get_playermove(board, player):
    """Take input from the player"""
    while True:
        try:
            move = int(input(f"Player {player}, enter your move (1 - 9): ")) - 1
            row, col = divmod(move, 3)
            if 0 <= move < 9 and board[row][col] == " ":
                return row, col
            else:
                print("Invalid move! That spot is already taken or input is out of range.")
        except ValueError:
            print("Invalid input! Enter a number between 1 and 9.")

def play_game():
    """Main function to run the game"""
    while True:
        board = [[" " for _ in range(3)] for _ in range(3)]
        players = ["X", "O"]
        turn = 0

        print("Welcome to the Tic Tac Toe Game")
        print("Board position:")
        print(" 1 | 2 | 3 ")
        print("-----------")
        print(" 4 | 5 | 6 ")
        print("-----------")
        print(" 7 | 8 | 9 ")
        print("-----------")

        while True:
            print_board(board)
            player = players[turn % 2]
            row, col = get_playermove(board, player)
            board[row][col] = player

            if check_winner(board, player):
                print_board(board)
                print(f"Congrats! Player {player} wins!")
                break
            elif is_draw(board):
                print_board(board)
                print("It's a draw!")
                break

            turn += 1  # Move to the next turn

        replay = input("Do you want to play again? (yes/no): ").strip().lower()
        if replay != "yes":
            print("Thanks for playing!")
            break

play_game()
